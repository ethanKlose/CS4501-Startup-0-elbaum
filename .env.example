# Copy to .env (never commit .env)
SECRET_KEY=change-me-in-prod
DATABASE_URL=sqlite:///./platejoy.db
# Real LLM: set ONE key (OpenAI wins if both are set). Each teammate uses their own
# key in their own .env; never commit it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Leave blank to use the built-in offline fake LLM (works with no key).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Used for calendar week boundaries.
TIMEZONE=America/New_York
