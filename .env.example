# Copy to .env (never commit .env)
SECRET_KEY=change-me-in-prod
DATABASE_URL=sqlite:///./platejoy.db
# Real LLM: set ONE key (OpenAI wins if both are set). Each teammate uses their own
# key in their own .env; never commit it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Leave blank to use the built-in offline fake LLM (works with no key).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Used for calendar week boundaries.
TIMEZONE=America/New_York

# Deployment: production requires a random SECRET_KEY (32+ chars) and HTTPS URL.
APP_ENV=development
PUBLIC_BASE_URL=http://127.0.0.1:8000
RATE_LIMIT_ENABLED=1
AUTH_RATE_LIMIT=20
GENERATION_RATE_LIMIT=10
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=5000
# Password recovery: blank SMTP_HOST writes to a private local .local-mail outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=no-reply@platejoy.local
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional evaluation-only rates. Leave blank if cost is unknown.
INPUT_USD_PER_MILLION=
OUTPUT_USD_PER_MILLION=

# Optional Instacart shopping-list link API; no cart/order is submitted.
INSTACART_API_KEY=
INSTACART_ENV=development

# Optional Google Calendar OAuth (Web application client, not an API key).
# Requires a unique 32+ character SECRET_KEY and a Fernet key; see BETA_INTEGRATIONS.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/integrations/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Optional live Google test: local PlateJoy login email after OAuth connection.
LIVE_GOOGLE_USER_EMAIL=
# Per-user hourly limit for integration POST actions.
INTEGRATION_RATE_LIMIT=20

# Optional Kroger Public API application (Products, Locations, Cart).
# Existing GOOGLE_TOKEN_ENCRYPTION_KEY can encrypt Kroger tokens too.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
KROGER_REDIRECT_URI=http://127.0.0.1:8000/integrations/kroger/callback
# Optional separate Fernet key; blank reuses GOOGLE_TOKEN_ENCRYPTION_KEY.
KROGER_TOKEN_ENCRYPTION_KEY=
# Optional read-only live smoke test; local PlateJoy login email after connecting.
LIVE_KROGER_USER_EMAIL=
LIVE_KROGER_ZIP=22903
